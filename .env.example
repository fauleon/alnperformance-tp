# ---------------------------------------------------------------- API (apps/api)
APP_ENV=development                       # production em produção (valida tudo abaixo)
DATABASE_URL=sqlite+aiosqlite:///./aln_hub_ia.db   # produção: Postgres do Railway (postgresql://...)
APP_URL=http://localhost:3000             # origem pública do painel
PUBLIC_API_URL=http://localhost:3000/api  # base pública da API = APP_URL + /api (precisa bater com a redirect URI)
CORS_ORIGINS=http://localhost:3000

# Travas. Mutações só passam com GLOBAL_KILL_SWITCH=false E a flag da plataforma true.
GLOBAL_KILL_SWITCH=true
GOOGLE_ADS_MUTATIONS_ENABLED=false
TIKTOK_ADS_MUTATIONS_ENABLED=false
DEFAULT_DAILY_BUDGET_LIMIT=100.00

# Chaves Fernet separadas por vírgula, a mais nova primeiro (python -m app.cli generate-key)
TOKEN_ENCRYPTION_KEYS=

# Google Ads (Google Cloud: OAuth Client "Web application"; MCC: Central de API)
# Redirect URI autorizada: <PUBLIC_API_URL>/v1/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=             # ID da MCC sem traços (informativo; a MCC de cada conta é descoberta no OAuth)

# TikTok for Business (Marketing API). Redirect: <PUBLIC_API_URL>/v1/connections/tiktok/callback
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Copiloto de IA (opcional; sem chave ele responde com base na auditoria)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

ALLOW_SIGNUP=false                        # acesso por convite
RUN_WORKER_IN_API=false                   # true só se não houver serviço worker separado
SENTRY_DSN=
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Web (apps/web)
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # build-time
API_INTERNAL_URL=http://localhost:8000       # runtime: onde o servidor web alcança a API
